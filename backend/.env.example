# --- CẤU HÌNH SERVER BACKEND ---
# Đổi PORT thành cổng bạn muốn chạy trên Server thật (VD: 8080, 3001)
PORT=3001

# --- CẤU HÌNH DATABASE ---
DATABASE_URL="mysql://username:password@localhost:3306/dk_cmms"

# --- CẤU HÌNH BẢO MẬT ---
CORS_ORIGIN="http://localhost:5173"
KEYCLOAK_JWKS_URI="http://localhost:8080/realms/cmms/protocol/openid-connect/certs"
KEYCLOAK_ISSUER="http://localhost:8080/realms/cmms"
KEYCLOAK_AUDIENCE="cmms-app"

# HRM Single Sign-On
HRM_JWT_SECRET=your_hrm_jwt_secret_here

# HRM External API Integration
HRM_API_URL=https://hrm.example.com

# Set this to your employee code to automatically grant ADMIN role on login
ADMIN_EMPLOYEE_CODE=
